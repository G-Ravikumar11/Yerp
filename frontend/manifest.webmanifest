      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Drawings & Photos", "short_name": "Photos", "url": "/app.html#drawings-view",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
