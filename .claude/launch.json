{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portal-neon",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8931",
        "--app-dir",
        "backend"
