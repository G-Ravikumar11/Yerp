{
  "_about": "Shared by backend/tests/test_programme_engine.py and frontend/src/lib/programme.test.ts: the same answers from both engines. Week of 2 Nov 2026: Mon 2 ... Sat 7, Sun 8 (off), Mon 9 ... Sat 14, Sun 15 (off). Expected values are worked out by hand from the rules in app/services/programme_engine.py.",
  "cases": [
    {
      "name": "a leaf skips Sunday",
      "rows": [{"id": 1, "name": "Putty", "start": "2026-11-05", "days": 4}],
      "expect": {"1": {"start": "2026-11-05", "end": "2026-11-09", "days": 4, "wbs": "1"}}
    },
    {
      "name": "an End typed instead of Days gives the working days between",
      "rows": [{"id": 1, "name": "Putty", "start": "2026-11-05", "end": "2026-11-10"}],
      "expect": {"1": {"start": "2026-11-05", "end": "2026-11-10", "days": 5}}
    },
    {
      "name": "a start on Sunday moves to Monday",
      "rows": [{"id": 1, "name": "Primer", "start": "2026-11-08", "days": 1}],
      "expect": {"1": {"start": "2026-11-09", "end": "2026-11-09", "days": 1}}
    },
    {
      "name": "a holiday is skipped like a Sunday",
