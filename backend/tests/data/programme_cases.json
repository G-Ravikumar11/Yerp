      "rows": [{"id": 1, "name": "Paint", "start": "2026-11-05", "days": 3}],
      "expect": {"1": {"start": "2026-11-05", "end": "2026-11-09", "days": 3}}
    },
    {
      "name": "counting calendar days ignores Sundays and holidays",
      "calendar": {"calendar_days": true, "holidays": ["2026-11-06"]},
