      "links": [{"successor": 2, "predecessor": 1, "kind": "FS", "lag": -1}],
      "expect": {"2": {"start": "2026-11-04", "end": "2026-11-05"}}
    },
    {
      "name": "SS+2 starts two working days after the predecessor starts",
