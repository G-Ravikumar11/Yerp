# ---------------------------------------------------------------------------
# Y ERP - environment
#
# Copy to .env for local work. On Railway these go in the service Variables
# tab instead; .env is never deployed and never committed.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Long random string. Sessions are signed with it, so if it changes every boot
# then every signed-in user is signed out on every redeploy.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Neon connection string, from the Neon dashboard (use the pooled one).
# postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Without this the app falls back to a local SQLite file that a redeploy
# throws away, data and all.
DATABASE_URL=

# The public URL. Password-reset and invoice-tracking links are built from it.
APP_BASE_URL=https://your-app.up.railway.app

# --- Sign-in and email ------------------------------------------------------

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Powers both "Continue with Google" and sending mail through Gmail.
# Authorised redirect URIs must include BOTH of:
#   https://your-app.up.railway.app/api/auth/google/callback   (sign-in)
#   https://your-app.up.railway.app/api/auth/callback          (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Y ERP

# --- Administration ---------------------------------------------------------
# Change both. ADMIN_PASSWORD defaults to "admin" and guards the /admin panel,
# which has direct table access.
ADMIN_PASSWORD=
SUPERADMIN_EMAILS=you@yourdomain.com
SUPERADMIN_PASSWORD=

# --- Cookies and CORS -------------------------------------------------------
COOKIE_SECURE=true
CORS_ORIGINS=https://your-app.up.railway.app
SESSION_MAX_AGE=86400

# --- AI (optional) ----------------------------------------------------------
# Free tier at console.groq.com. Without it every AI feature says so plainly
# rather than failing.
GROQ_API_KEY=

# --- Connection pool (optional) ---------------------------------------------
# Neon's free tier is not generous with connections; raise only if needed.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Scheduler --------------------------------------------------------------
# Recurring invoices, overdue chasing, interview reminders. Leave on for one
# instance; if you scale to several, they coordinate through a job-claim lock.
SCHEDULER_ENABLED=1

# --- Payment gateways (only if you charge tenants for using the platform) ---
PLATFORM_CURRENCY=INR
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
