
# --- Wallet & payment gateways ---------------------------------------------
# Top-ups stay disabled until these are set; the UI says so rather than
# offering a button that fails.
PLATFORM_CURRENCY=GBP
TOPUP_MIN=5
TOPUP_MAX=5000
WALLET_LOW_BALANCE=5

# Stripe — webhook secret is required, unverified webhooks are refused
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint: POST /api/wallet/webhook/stripe  (checkout.session.completed)

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Webhook endpoint: POST /api/wallet/webhook/razorpay  (payment.captured)

# PayPal — sandbox | live. Capture is verified server-side, no webhook needed.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
